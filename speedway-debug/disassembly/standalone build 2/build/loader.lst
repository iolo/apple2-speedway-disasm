Main file   : src/loader.s
Current file: src/loader.s

000000r 1               ; The 44-byte relocation stub formerly stored in Applesoft line 190 DATA.
000000r 1               ; Applesoft declares GR before CALL $0300. ROM MOVE copies the inclusive
000000r 1               ; staging range $4400-$69FF to runtime $0400-$29FF. This destroys BASIC.
000000r 1               ; The initial orchard page remains visible during the delay, then game_entry
000000r 1               ; builds its tables and presents the title. There is no return to Applesoft.
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .segment "LOADER"
000000r 1                       .export relocate_and_start
000000r 1               
000000r 1               MOVE_SOURCE     = $3C             ; monitor A1L/A1H
000000r 1               MOVE_END        = $3E             ; monitor A2L/A2H (inclusive)
000000r 1               MOVE_DEST       = $42             ; monitor A4L/A4H
000000r 1               ROM_MOVE        = $FE2C
000000r 1               ROM_WAIT        = $FCA8
000000r 1               GAME_ENTRY      = $2970           ; asserted by src/speedway.s
000000r 1               
000000r 1               relocate_and_start:
000000r 1  A9 00                lda     #<$4400
000002r 1  85 3C                sta     MOVE_SOURCE
000004r 1  A9 44                lda     #>$4400
000006r 1  85 3D                sta     MOVE_SOURCE+1
000008r 1  A9 FF                lda     #<$69FF           ; corrected inclusive end, not $6A00
00000Ar 1  85 3E                sta     MOVE_END
00000Cr 1  A9 69                lda     #>$69FF
00000Er 1  85 3F                sta     MOVE_END+1
000010r 1  A9 00                lda     #<$0400
000012r 1  85 42                sta     MOVE_DEST
000014r 1  A9 04                lda     #>$0400
000016r 1  85 43                sta     MOVE_DEST+1
000018r 1  A0 00                ldy     #$00
00001Ar 1  20 2C FE             jsr     ROM_MOVE
00001Dr 1  A0 0A                ldy     #$0A
00001Fr 1               delay:
00001Fr 1  A9 FF                lda     #$FF
000021r 1  20 A8 FC             jsr     ROM_WAIT
000024r 1  88                   dey
000025r 1  C0 00                cpy     #$00              ; retain the original two-byte comparison
000027r 1  D0 F6                bne     delay
000029r 1  4C 70 29             jmp     GAME_ENTRY
00002Cr 1               loader_end:
00002Cr 1                       .assert relocate_and_start = $0300, lderror, "loader origin changed"
00002Cr 1                       .assert loader_end-relocate_and_start = 44, error, "loader size changed"
00002Cr 1               
