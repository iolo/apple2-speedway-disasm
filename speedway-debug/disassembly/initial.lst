ca65 V2.19 - Git a162565ec
Main file   : tmp/src/speedway.s
Current file: tmp/src/speedway.s

000000r 1               ; Crowded Speedway, Dec. 1984: ca65 reconstruction of the REPAIRED dump.
000000r 1               ; Source dump addresses $4400-$69FF become runtime $0400-$29FF.
000000r 1               ; All instruction/address annotations below use runtime addresses.
000000r 1               ; Default source must reproduce the working 9728-byte payload exactly.
000000r 1               ; Live code was traced recursively from game_entry ($2970). Two unreferenced
000000r 1               ; instruction fragments are identified explicitly. All other bytes are retained
000000r 1               ; as data, graphics, or padding; opaque pixels are not treated as opcodes.
000000r 1               ; No INCBIN or reference binary is required to assemble this source.
000000r 1               
000000r 1                       .setcpu "6502"
000000r 1                       .include "memory.inc"
000000r 2               ; Named Apple II hardware, ROM entries, and game zero-page variables.
000000r 2               ; Addresses are runtime addresses after relocation; the payload is stored at +$4000.
000000r 2               ; Zero page is owned by the game; it does not preserve Applesoft state.
000000r 2               
000000r 2               curve_index                = $00       ; road curve/table index
000000r 2               view_offset                = $01       ; signed horizontal viewport/player offset
000000r 2               work_ptr_lo                = $02       ; shared pointer / byte scratch
000000r 2               work_ptr_hi                = $03       ; shared pointer high / row count
000000r 2               draw_ptr_lo                = $04       ; shared destination pointer low
000000r 2               draw_ptr_hi                = $05       ; shared destination pointer high / sign
000000r 2               random_ptr_lo              = $06       ; ROM stream pointer low
000000r 2               random_ptr_hi              = $07       ; ROM stream pointer high
000000r 2               random_index               = $08       ; ROM stream offset
000000r 2               scenery_offset             = $09       ; wrapping scenery-strip index
000000r 2               segment_steps              = $0A       ; remaining straight/curve updates
000000r 2               segment_turn               = $0B       ; zero=straight; sign chooses turn
000000r 2               straight_steps             = $0C       ; straight-section duration
000000r 2               curve_steps                = $0D       ; turn-section duration
000000r 2               brake_divider              = $0E       ; car-slowdown divider
000000r 2               brake_reserve              = $0F       ; remaining brake reserve, recovered when released
000000r 2               brake_failed               = $10       ; nonzero after reserve reaches zero
000000r 2               high_score                 = $11       ; eight high-bit decimal characters ($11-$18)
000000r 2               random_xor_lo              = $4E       ; evolving XOR seed low
000000r 2               random_xor_hi              = $4F       ; evolving XOR seed high
000000r 2               multiply_factor_lo         = $50       ; shift/add addend low
000000r 2               multiply_factor_hi         = $51       ; shift/add addend high
000000r 2               multiply_result_lo         = $52       ; shift/add result low
000000r 2               multiply_result_hi         = $53       ; shift/add result high
000000r 2               multiply_bits              = $54       ; shifted source bits
000000r 2               car_one_active             = $60       ; active flag
000000r 2               car_one_path_lo            = $61       ; lane-table pointer low
000000r 2               car_one_path_hi            = $62       ; lane-table pointer high
000000r 2               car_one_depth              = $63       ; distance/depth counter
000000r 2               car_one_speed              = $64       ; alternating update flag
000000r 2               car_one_draw_lo            = $65       ; row-buffer pointer low
000000r 2               car_one_draw_hi            = $66       ; row-buffer pointer high
000000r 2               car_one_lookup_lo          = $67       ; perspective lookup pointer low
000000r 2               car_one_lookup_hi          = $68       ; perspective lookup pointer high
000000r 2               left_sign_active           = $70       ; active flag
000000r 2               left_sign_depth            = $71       ; depth counter
000000r 2               left_sign_draw_lo          = $72       ; row-buffer pointer low
000000r 2               left_sign_draw_hi          = $73       ; row-buffer pointer high
000000r 2               left_sign_lookup_lo        = $74       ; perspective pointer low
000000r 2               left_sign_lookup_hi        = $75       ; perspective pointer high
000000r 2               right_sign_active          = $80       ; active flag
000000r 2               right_sign_depth           = $81       ; depth counter
000000r 2               right_sign_draw_lo         = $82       ; row-buffer pointer low
000000r 2               right_sign_draw_hi         = $83       ; row-buffer pointer high
000000r 2               right_sign_lookup_lo       = $84       ; perspective pointer low
000000r 2               right_sign_lookup_hi       = $85       ; perspective pointer high
000000r 2               car_two_active             = $90       ; active flag
000000r 2               car_two_path_lo            = $91       ; lane-table pointer low
000000r 2               car_two_path_hi            = $92       ; lane-table pointer high
000000r 2               car_two_depth              = $93       ; distance/depth counter
000000r 2               car_two_speed              = $94       ; alternating update flag
000000r 2               car_two_draw_lo            = $95       ; row-buffer pointer low
000000r 2               car_two_draw_hi            = $96       ; row-buffer pointer high
000000r 2               car_two_lookup_lo          = $97       ; perspective lookup pointer low
000000r 2               car_two_lookup_hi          = $98       ; perspective lookup pointer high
000000r 2               last_score                 = $A0       ; eight saved score characters ($A0-$A7)
000000r 2               
000000r 2               ; Display text fields, shared with the HUD templates.
000000r 2               SCORE_TEXT                 = $075D
000000r 2               CARS_LEFT_TEXT             = $076E
000000r 2               HIGH_SCORE_TEXT            = $07DD
000000r 2               KEYBOARD                   = $C000
000000r 2               SPEAKER                    = $C030
000000r 2               PADDLE_BUTTON0             = $C061
000000r 2               ROM_PREAD                  = $FB1E
000000r 2               ROM_WAIT                   = $FCA8
000000r 2               
000000r 2               ; ROM_PREAD: X=paddle number, returns timed paddle value in Y.
000000r 2               ; ROM_WAIT: delay controlled by A (zero wraps for a long delay); A/flags clobbered.
000000r 2               ; SPEAKER toggles on access; PADDLE_BUTTON0 is pressed when bit 7 is set.
000000r 2               
000000r 1                       .segment "PAYLOAD"
000000r 1                       .export game_entry, game_loop, handle_crash, game_over, new_game
000000r 1               payload_start:
000000r 1               
000000r 1               
000000r 1                       .include "initial-screen.inc"
000000r 2               ; Initial 1 KB lores orchard page. The loader copies this straight to page 1.
000000r 2               ; It is visible during the loader delay, then overwritten by the game.
000000r 2               ; Runtime $0400-$07FF; dump $4400-$47FF.
000000r 2               
000000r 2               initial_orchard_page:
000000r 2                       .assert * = $0400, lderror, "address drift: initial_orchard_page"
